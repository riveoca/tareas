# --- Jira Cloud ---
JIRA_URL=https://tu-empresa.atlassian.net
JIRA_EMAIL=tu.correo@empresa.com
# Crear en https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ
# Opcional: id del campo de story points (p.ej. customfield_10016).
# Si se deja vacío se detecta automáticamente por nombre.
JIRA_STORY_POINTS_FIELD=
# Opcional: id del campo "Fecha de inicio" (p.ej. customfield_10015). Vacío = autodetectar.
JIRA_START_DATE_FIELD=
# Story points que se ponen a cada tarea generada. Vacío = ninguno (el desglose ya se hace a tamaño de 1 punto)
TASK_STORY_POINTS=

# --- IA ---
# Proveedor por defecto: claude_code | claude | ollama (se puede cambiar en la app)
#  - claude_code: usa tu cuenta de Claude (Pro/Team/Enterprise) a través de Claude Code. No necesita API key.
#  - claude: API de Anthropic (necesita ANTHROPIC_API_KEY)
#  - ollama: IA local
LLM_PROVIDER=claude_code

# Claude Code: comando y modelo opcional (vacío = el predeterminado de tu cuenta)
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_MODEL=

# Claude (API de Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Esfuerzo: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Si Claude rechaza una petición, reintentar con otro modelo en el servidor ("default") o vacío para desactivar
CLAUDE_FALLBACKS=default

# IA local (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# --- App ---
TAREAS_DB=tareas.db
